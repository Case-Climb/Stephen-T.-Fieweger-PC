# Site
NEXT_PUBLIC_SITE_URL=https://www.fiewegerlaw.com

# Contact form delivery (SMTP). Submissions go to CONTACT_TO.
CONTACT_TO=sfieweger@fiewegerlaw.com
CONTACT_FROM="Fieweger Law Website <no-reply@fiewegerlaw.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Invisible bot protection (Cloudflare Turnstile, "invisible" widget mode). Optional but recommended.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 (loads only after the visitor accepts analytics cookies)
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
